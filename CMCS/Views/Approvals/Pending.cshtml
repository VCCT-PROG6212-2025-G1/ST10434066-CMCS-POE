@model IEnumerable<CMCS.Models.Claim>
@using CMCS.Models

@{
    ViewData["Title"] = "Approvals";
    var role = ViewBag.Role as string ?? "";
}

<h2 class="mb-3">Approvals - @role</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">No claims waiting .</div>
}
else
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Lecturer</th>
                <th>Month/Year</th>
                <th>Hours</th>
                <th>Rate</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Docs</th>
                <th style="width: 160px;">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@(c.Lecturer != null ? c.Lecturer.FullName : "Unknown")</td>
                    <td>@c.Month/@c.Year</td>
                    <td>@c.HoursWorked</td>
                    <td>@c.HourlyRate.ToString("F2")</td>
                    <td>@c.Amount.ToString("F2")</td>
                    <td>@c.Status</td>
                    <td>
                        @if (c.Documents != null && c.Documents.Any())
                        {
                            @foreach (var d in c.Documents)
                            {
                                <a href="@d.FileUrl" target="_blank" class="btn btn-sm btn-outline-secondary mb-1">
                                    @d.FileName
                                </a>
                
                                <br />
                            }
                        }
                        else
                        {
                            <span class="text-muted">None</span>
                        }
                    </td>
                    <td>
                        @* Coordinator: Pending  *@
                        @if (role == "Coordinator" && c.Status == ClaimStatus.Pending)
                        {
                            <form asp-action="Verify" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@c.ClaimID" />
                                <button type="submit" class="btn btn-sm btn-primary">Verify</button>
                            </form>
                        }
                        @* Manager: Verified  *@
                        else if (role == "Manager" && c.Status == ClaimStatus.Verified)
                        {
                            <form asp-action="Approve" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@c.ClaimID" />
                                <button type="submit" class="btn btn-sm btn-success">Approve</button>
                            </form>
                        }
                        @* HR: Approved  *@
                        else if (role == "HR" && c.Status == ClaimStatus.Approved)
                        {
                            <form asp-action="Finalise" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@c.ClaimID" />
                                <button type="submit" class="btn btn-sm btn-warning">Finalise</button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted">No action</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}