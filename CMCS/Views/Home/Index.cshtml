@{
    ViewData["Title"] = "Home";
}

<div class="p-4 bg-light rounded-3">
    <h1>Contract Monthly Claim System</h1>
    <p class="lead mb-3">Submit a claim or view submitted claims.</p>

    @* Lecturer only *@
    @if (Context.Session.GetString("Role") == "Lecturer")
    {
        <a class="btn btn-primary"
           asp-controller="Claims"
           asp-action="Create">
            Submit a Claim
        </a>
    }

    <a class="btn btn-outline-secondary ms-2"
       asp-controller="Claims"
       asp-action="Index">
        View Claims
    </a>

    <a class="btn btn-dark ms-2"
       asp-controller="Approvals"
       asp-action="Pending">
        Approvals
    </a>
</div>