@using Microsoft.AspNetCore.Http

@{
    var role = Context.Session.GetString("Role");
    var name = Context.Session.GetString("FullName");
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CMCS</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>

<body>
   
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">

            <a class="navbar-brand" href="/">CMCS</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navCMCS" aria-controls="navCMCS"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navCMCS">
                <ul class="navbar-nav me-auto">

                    @* Only show menu items if logged in *@
                    @if (!string.IsNullOrEmpty(role))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Claims" asp-action="Create">Submit Claim</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Claims" asp-action="Index">View Claims</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Approvals" asp-action="Pending">Approvals</a>
                        </li>

                        @* HR  *@
                        if (role == "HR")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="HR" asp-action="Index">HR View</a>
                            </li>
                        }
                    }
                </ul>

                @if (!string.IsNullOrEmpty(role))
                {
                    <span class="navbar-text me-3">
                        @name (@role)
                    </span>
                    <a class="btn btn-outline-light btn-sm"
                       asp-controller="Account" asp-action="Logout">
                        Logout
                    </a>
                }
            </div>
        </div>
    </nav>

  
    <div class="container mt-4">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)

    <footer class="border-top mt-4 py-3">
        <div class="container d-flex justify-content-between">
            <span class="text-muted">© @DateTime.Now.Year CMCS – PROG6212 POE</span>
            <a asp-controller="Home" asp-action="Privacy" class="text-muted">
                Privacy Policy
            </a>
        </div>
    </footer>
</body>
</html>