@model IEnumerable<CMCS.Models.Claim>
@{
    ViewData["Title"] = "Claims";
}
<h2>All Claims</h2>
<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Lecturer</th>
            <th>Month</th>
            <th>Year</th>
            <th>Hours</th>
            <th>Rate</th>
            <th>Amount</th>
            <th>Status</th>
            <th>Docs</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.ClaimID</td>
                <td>@c.Lecturer?.FullName</td>
                <td>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(c.Month)</td>
                <td>@c.Year</td>
                <td>@c.HoursWorked</td>
                <td>@c.HourlyRate</td>
                <td>@c.Amount</td>
                <td>
                    @switch (c.Status)
                    {
                        case CMCS.Models.ClaimStatus.Pending:
                            <text><span class="badge bg-warning text-dark">Pending</span></text>
                            ; break;
                        case CMCS.Models.ClaimStatus.Approved:

                            <text><span class="badge bg-success">Approved</span></text>
                            ; break;
                        case CMCS.Models.ClaimStatus.Rejected:

                            <text><span class="badge bg-danger">Rejected</span></text>
                            ; break;
                    }
                </td>
                <td>
                    @if (c.Documents?.Any() == true)
                    {
                        <ul class="mb-0">
                            @foreach (var d in c.Documents)
                            {
                                <li><a href="@d.FileUrl" target="_blank">@d.FileName</a></li>
                            }
                        </ul>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>