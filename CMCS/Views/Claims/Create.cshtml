@model CMCS.Models.Claim
@using CMCS.Models

@{
    ViewData["Title"] = "Submit a Claim";
    var lecturer = ViewBag.Lecturer as Lecturer;
    var currentYear = DateTime.UtcNow.Year;
}

<h2 class="mb-3">Submit Claim</h2>

<form asp-action="Create" method="post" enctype="multipart/form-data" class="row g-3">
    @Html.AntiForgeryToken()

    <div class="col-12">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    </div>

    <!-- Lecturer -->
    <div class="col-md-5">
        <label class="form-label">Lecturer</label>
        <input class="form-control" type="text"
               value="@(lecturer?.FullName) (@lecturer?.StaffNo)"
               readonly />

        <input type="hidden" asp-for="LecturerID" value="@(lecturer?.LecturerID)" />
        <input type="hidden" id="HourlyRateValue" value="@(lecturer?.HourlyRate)" />
    </div>

    <!-- Month -->
    <div class="col-md-2">
        <label class="form-label">Month</label>
        <select asp-for="Month" class="form-select" required>
            <option value="">--</option>
            @for (var m = 1; m <= 12; m++)
            {
                <option value="@m">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
            }
        </select>
        <span asp-validation-for="Month" class="text-danger"></span>
    </div>

    <!-- Year -->
    <div class="col-md-2">
        <label class="form-label">Year</label>
        <select asp-for="Year" class="form-select" required>
            <option value="">--</option>
            @for (var y = currentYear - 1; y <= currentYear + 1; y++)
            {
                <option value="@y">@y</option>
            }
        </select>
        <span asp-validation-for="Year" class="text-danger"></span>
    </div>

    <!-- Hours -->
    <div class="col-md-3">
        <label class="form-label">Hours Worked</label>
        <input asp-for="HoursWorked" id="HoursWorked" class="form-control"
               type="number" step="0.25" min="0.25" required />
        <span asp-validation-for="HoursWorked" class="text-danger"></span>
    </div>

    <!-- Hourly Rate Preview -->
    <div class="col-md-3">
        <label class="form-label">Hourly Rate</label>
        <input id="RatePreview" class="form-control" type="text" readonly />
    </div>

    <!-- Amount Preview -->
    <div class="col-md-3">
        <label class="form-label">Amount</label>
        <input id="AmountPreview" class="form-control" type="text" readonly />
    </div>

    <!-- Upload -->
    <div class="col-md-6">
        <label class="form-label">Upload Supporting Document (.pdf/.docx/.xlsx)</label>
        <input type="file" name="upload" class="form-control" accept=".pdf,.docx,.xlsx" />
        @if (TempData["UploadError"] != null)
        {
            <div class="text-danger small mt-1">@TempData["UploadError"]</div>
        }
    </div>

    <!-- Buttons -->
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Submit</button>
        <a href="/" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const hoursWorkedInput = document.getElementById("HoursWorked");
            const rateField = document.getElementById("RatePreview");
            const amountField = document.getElementById("AmountPreview");
            const rateValueHidden = document.getElementById("HourlyRateValue");

            const rate = parseFloat(rateValueHidden?.value || "0");

            function toMoney(n) {
                const x = Number(n);
                return Number.isNaN(x)
                    ? ""
                    : x.toLocaleString(undefined, {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    });
            }

            function updatePreview() {
                const hours = parseFloat(hoursWorkedInput.value || "0");
                rateField.value = rate ? toMoney(rate) : "";
                amountField.value = rate && hours ? toMoney(rate * hours) : "";
            }

            if (hoursWorkedInput) {
                hoursWorkedInput.addEventListener("input", updatePreview);
            }

            updatePreview();
        });
    </script>
}